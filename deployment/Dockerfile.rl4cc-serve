FROM python:3.12.3-slim

# ------------------------------------------------------------------
# Environment
# ------------------------------------------------------------------
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
# -- RL4CC installation
ENV RL4CC_URL=https://github.com/unimib-datAI/dfaas-rl4cc.git
ENV RL4CC_RAW_URL=https://raw.githubusercontent.com/unimib-datAI/dfaas-rl4cc
ENV RL4CC_TAG=dfaas
# -- runtime configuration
ENV CHECKPOINT_DIR=/app/checkpoints
ENV CONFIGURATION_FILE=/app/config/config.json
ENV LOG_FILE_BASE=/app/logs/rl4cc
# -- bootstrap modules (comma-separated, optional)
ENV APP_BOOTSTRAP_MODULES=""

# ------------------------------------------------------------------
# System dependencies
# ------------------------------------------------------------------
RUN apt-get update && apt-get install -y \
    build-essential \
    gcc \
    g++ \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------------
# Create non-root user
# ------------------------------------------------------------------
RUN useradd -m appuser

# ------------------------------------------------------------------
# Install dependencies
# ------------------------------------------------------------------
RUN pip install --upgrade pip
RUN pip install --no-cache-dir \
    numpy==2.3.0 \
    ray[rllib]==2.40.0 \
    pandas \
    fastapi \
    uvicorn \
    pydantic \
    gymnasium \
    cloudpickle \
    matplotlib

# Required by DFaaS-specific code. We do not use a GPU for inference.
RUN pip install --no-cache-dir torch==2.7.1 --index-url https://download.pytorch.org/whl/cpu

# ------------------------------------------------------------------
# Install RL4CC from Git
# ------------------------------------------------------------------
RUN pip install git+${RL4CC_URL}@${RL4CC_TAG}
RUN mkdir /app && curl -L ${RL4CC_RAW_URL}/${RL4CC_TAG}/deployment/rl4cc-serve.sh -o /app/rl4cc-serve.sh

# Patch Ray with patches in RL4CC
RUN curl -L \
    ${RL4CC_RAW_URL}/${RL4CC_TAG}/deployment/patches/ray_debug.patch -o /tmp/ray_debug.patch \
    ${RL4CC_RAW_URL}/${RL4CC_TAG}/deployment/patches/ray_fcnet.patch -o /tmp/ray_fcnet.patch \
    ${RL4CC_RAW_URL}/${RL4CC_TAG}/deployment/patches/torch_action_dist.patch -o /tmp/torch_action_dist.patch
RUN set -e; for patchfile in /tmp/*.patch; do patch --batch -p0 < "$patchfile"; done

# ------------------------------------------------------------------
# Create directories expected by env variables
# ------------------------------------------------------------------
RUN mkdir -p /app/checkpoints /app/config /app/logs

# ------------------------------------------------------------------
# Copy additional files from context
# ------------------------------------------------------------------
COPY . /app

# ------------------------------------------------------------------
# Set ownership and change user
# ------------------------------------------------------------------
ENV PYTHONPATH=/app
RUN chown -R appuser:appuser /app
USER appuser

# ------------------------------------------------------------------
# Expose port
# ------------------------------------------------------------------
EXPOSE 8000

# ------------------------------------------------------------------
# Run FastAPI app
# ------------------------------------------------------------------
WORKDIR /app
RUN chmod +x rl4cc-serve.sh
ENTRYPOINT ["./rl4cc-serve.sh"]
